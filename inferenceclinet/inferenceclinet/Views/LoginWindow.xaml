<Window x:Class="inferenceclinet.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="로그인" Height="380" Width="420"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="소비자 로그인" FontSize="22" FontWeight="Bold" Margin="0,0,0,24"/>

        <TextBlock Text="아이디" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="IdTextBox" Height="44" Margin="0,0,0,16"/>

        <TextBlock Text="비밀번호" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="LoginPasswordBox" Height="47" Margin="0,0,0,24"/>

        <Button x:Name="LoginButton" Content="로그인" Height="38" FontSize="14" Click="OnLoginClick" IsDefault="True"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </StackPanel>
</Window>